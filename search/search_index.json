{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"]},"docs":[{"location":"newthings/","title":"\u60f3\u8981\u5b66\u4e60\u7684\u5185\u5bb9","text":"<p>1.\u5317\u5e08\u5927 \u666e\u901a\u5fc3\u7406\u5b66 2.Yale \u5fc3\u7406\u5b66</p>"},{"location":"other/","title":"\u5efa\u7ad9","text":"<p>#\u6e90\u81ea\u54d4\u54e9\u54d4\u54e9 NextDeep bv\u53f7BV1jqNZeaE9e \u4f7f\u7528mkdocs-material\u5efa\u7ad9 \u57fa\u4e8epython\u73af\u5883</p>"},{"location":"other/#1mkdocs","title":"1.\u5b89\u88c5mkdocs\u5e76\u521b\u5efa\u9879\u76ee","text":"<p><code>pip install mkdocs</code> <code>pip install mkdocs-material</code></p>"},{"location":"other/#1","title":"1.","text":"<p>\u9009\u62e9\u8def\u5f84 <code>cd \u4f60\u7684\u8def\u5f84</code> <code>mkdocs new \u6587\u4ef6\u540d</code></p>"},{"location":"other/#2","title":"2.\u66f4\u6539\u4e3b\u9898","text":"<p>\u5728vscode\u4e2d\u6253\u5f00<code>mkdocs.yml</code>\u6587\u4ef6\u8fdb\u884c\u914d\u7f6e \u683c\u5f0f\u53c2\u8003\u5b98\u7f51 https://www.mkdocs.org/</p>"},{"location":"other/#3","title":"3.\u9884\u89c8","text":"<p><code>cd \u6587\u4ef6\u540d</code> <code>mkdocs serve</code> \u590d\u5236\u7f51\u5740\u5e76\u6253\u5f00\uff08\u5728\u672c\u5730\u670d\u52a1\u5668\u5f62\u6210\u7ad9\u70b9\uff09\u6709\u66f4\u6539\u53ef\u968f\u65f6\u751f\u6210\u5e76\u9884\u89c8</p>"},{"location":"other/#2github","title":"2.\u6258\u7ba1\u5728github","text":""},{"location":"other/#1_1","title":"1.","text":"<p>\u5728github\u521b\u5efa\u4ed3\u5e93\u540e  </p> <pre><code>git init\ngit add .\ngit commit -m\"first\"\n</code></pre> <p>github\u4ed3\u5e93\u7684\u63a8\u9001\u4ee3\u7801\u2193</p> <pre><code>git remote add origin https://github.com/\u7528\u6237\u540d/\u4ed3\u5e93\u540d.git\ngit branch -M main\ngit push -u origin main\n</code></pre>"},{"location":"other/#2_1","title":"2.\u90e8\u7f72\u4e0e\u6784\u5efa","text":"<p><code>mkdocs gh-deploy</code>  \u7b49\u5f85\u90e8\u7f72\u5b8c\u6210 \u5728repository-settings-pages\u627e\u5230\u7f51\u5740</p>"},{"location":"other/#3_1","title":"3.\u7f51\u7ad9\u4f18\u5316","text":"<p>\u4f9d\u65e7\u53c2\u8003\u5b98\u7f51\uff0c\u4f7f\u7528markdown\u8bed\u6cd5 \u8fd9\u91cc\u7684docs&gt;index.md\u662f\u9ed8\u8ba4\u6587\u7ae0\uff0c\u65b0\u5efamd\u6587\u4ef6\u4ee5\u589e\u52a0\u6587\u7ae0 \u66f4\u65b0\u5185\u5bb9\u540e\u4f9d\u65e7\u4f7f\u7528<code>mkdocs gh-deploy</code>\u63a8\u9001\u5230github</p>"}]}